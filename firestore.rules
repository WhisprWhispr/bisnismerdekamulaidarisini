rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Aturan untuk tabel pendaftaran (registrations)
    match /registrations/{document=**} {
      
      // 1. TULIS (CREATE): Aturan super ketat anti-spam & anti-injeksi
      allow create: if 
        // Syarat Waktu: Harus lewat dari 17 Agustus 2026, 11:20 WIB (04:20 UTC)
        request.time >= timestamp("2026-08-17T04:20:00Z") &&
        
        // Syarat Struktur: Field harus persis dan lengkap (tidak boleh ada sisipan kode aneh)
        request.resource.data.keys().hasAll(['name', 'email', 'whatsapp', 'domain', 'category', 'timestamp', 'ip']) &&
        
        // Syarat Validasi Data (Spam Filter):
        request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.matches('^[^@]+@[^@]+\\.[a-zA-Z]{2,}$') &&
        request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('^[0-9+]{9,15}$') &&
        request.resource.data.domain is string && request.resource.data.domain.matches('^[a-zA-Z0-9-]+\\.netlify\\.app$') &&
        request.resource.data.category in ['ecommerce', 'portfolio', 'idcard'] &&
        request.resource.data.timestamp is number &&
        request.resource.data.ip is string;
      
      // 2. BACA (READ): Diizinkan untuk publik HANYA agar fitur 'Sisa Slot 10' berfungsi
      allow read: if true; 
      
      // 3. EDIT/HAPUS (UPDATE/DELETE): Mutlak hanya Admin
      allow update, delete: if request.auth != null;
    }
    
  }
}
